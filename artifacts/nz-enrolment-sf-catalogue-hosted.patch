+    const local = getNzCourse("oli", "studentpay-test-course")!;
+    const resolved = await resolveAuthoritativeHostedCourse(
+      tenant,
+      local,
+      async () => jsonResponse(200, { course: apiSuccess }),
+    );
+    assert.deepEqual(resolved, {
+      status: "unavailable",
+      reason: "forced_unavailable",
+    });
+  });
+});
