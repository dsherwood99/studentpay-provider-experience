# StudentPay Provider Checkout API (sandbox)
# These are already configured on Vercel for this project.
# Copy to .env.local for local development — do not commit secrets.

STUDENTPAY_API_BASE_URL=https://sandbox-api.studentpay.com.au
STUDENTPAY_PROVIDER_API_KEY=
STUDENTPAY_PROVIDER_CODE=SANDBOX_DEMO
STUDENTPAY_PROVIDER_ACCOUNT_ID=0018r0000165S4mAAE

# Pinch Capture.js publishable key (sandbox/test). Used for Pay Now card tokenisation.
# Prefer the server env; the GET /api/studentpay/provider-checkouts probe also falls
# back to sandbox-api /v1/environment.pinch_publishable_key once that is deployed.
PINCH_PUBLISHABLE_KEY=
# NEXT_PUBLIC_PINCH_PUBLISHABLE_KEY=

# Optional overrides if the default StudentPay paths differ by environment.
# PROVIDER_CHECKOUT_API_URL=https://sandbox-api.studentpay.com.au/v1/provider-checkouts
# PROVIDER_CHECKOUT_CONFIRM_API_URL=https://sandbox-api.studentpay.com.au/api/provider-checkout-confirm

# AU sandbox Bela Beauty PIC only. Server-side catalogue reads and checkout.
# Do not set these on production PE routing. Never expose to the browser.
# BELA_BEAUTY_SANDBOX_API_KEY=
# BELA_BEAUTY_SANDBOX_PROVIDER_ACCOUNT_ID=0018r000017BAHFAA4

# Dedicated Bela production Provider Experience (separate Vercel project).
# Do not set these on the sandbox harness. Never expose to the browser.
# Hostname: bela.studentpay.com.au
# / redirects to /providers/bela-beauty-college/courses on this dedicated host.
# STUDENTPAY_API_BASE_URL=https://api.studentpay.com.au
# STUDENTPAY_PROVIDER_CODE=BELA
# BELA_API_KEY=
# STUDENTPAY_PROVIDER_ACCOUNT_ID=001Mp00000WkleDIAR
# HARNESS_MOCK_MODE=false

# Dedicated Academy Australia production demo (separate Vercel project).
# Do not set these on studentpay-provider-experience sandbox.
# STUDENTPAY_API_BASE_URL=https://api.studentpay.com.au
# ACADEMY_PROVIDER_CODE=ACADEMYAU
# ACADEMYAU_API_KEY=
# ACADEMY_PROVIDER_ACCOUNT_ID=001Mp00000tiKOOIA2
# HARNESS_MOCK_MODE=false

# Optional. Leave unset (or false) when API credentials are present so sandbox
# checkouts hit StudentPay. Set true for local mock create/confirm without keys.
# HARNESS_MOCK_MODE=true

# NZ Enrolment Checkout. Server-side keys — never NEXT_PUBLIC_.
# Local/sandbox:
# HOSTED_PRODUCT_MODE=nz_enrolment
# STUDENTPAY_ENV=sandbox
# NZ_STUDENTPAY_API_BASE_URL=https://sandbox-api.studentpay.co.nz
# NZ_ENROLMENT_SESSION_SECRET=
# NZ_ENROLMENT_PUBLIC_BASE_URL=http://localhost:3000
# PROVIDER_API_KEY_OLI_NZ=
# SANDBOX_DEMO_API_KEY=
#
# Dedicated OLI Production Vercel project (do not set on Bela/Academy hosts):
# HOSTED_PRODUCT_MODE=nz_enrolment
# STUDENTPAY_ENV=production
# NZ_STUDENTPAY_API_BASE_URL=https://api.studentpay.co.nz
# NZ_ENROLMENT_PUBLIC_BASE_URL=https://enrol.studentpay.co.nz
# PROVIDER_API_KEY_OLI_NZ=

