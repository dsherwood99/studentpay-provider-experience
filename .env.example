# StudentPay Provider Checkout API (sandbox)
# These are already configured on Vercel for this project.
# Copy to .env.local for local development — do not commit secrets.

STUDENTPAY_API_BASE_URL=https://sandbox-api.studentpay.com.au
STUDENTPAY_PROVIDER_API_KEY=
STUDENTPAY_PROVIDER_CODE=SANDBOX_DEMO
STUDENTPAY_PROVIDER_ACCOUNT_ID=0018r0000165S4mAAE

# Optional overrides if the default StudentPay paths differ by environment.
# PROVIDER_CHECKOUT_API_URL=https://sandbox-api.studentpay.com.au/v1/provider-checkouts
# PROVIDER_CHECKOUT_CONFIRM_API_URL=https://sandbox-api.studentpay.com.au/api/provider-checkout-confirm

# Optional. Leave unset (or false) when API credentials are present so sandbox
# checkouts hit StudentPay. Set true for local mock create/confirm without keys.
# HARNESS_MOCK_MODE=true

# ---------------------------------------------------------------------------
# Bela Beauty College NZ enrolment (/enrol/bela-beauty/)
# Separate from AU wizard credentials above — points at StudentPay NZ sandbox.
# ---------------------------------------------------------------------------
STUDENTPAY_NZ_API_BASE_URL=https://sandbox-api.studentpay.co.nz
PROVIDER_API_KEY_BELA_NZ=
